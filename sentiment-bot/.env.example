# Copy to .env and fill. NEVER commit real values. Keys are capability-scoped:
# ingest=read-only, exec=trade-only+no-withdraw+IP-locked, watchdog=cancel/close-only.

# Ingest - primary (X API v2 filtered stream)
X_BEARER_TOKEN=

# Ingest - fallback A (LunarCrush/Santiment-style aggregator)
SENTIMENT_AGGREGATOR_URL=
SENTIMENT_AGGREGATOR_KEY=

# Score - primary (LLM classifier)
LLM_API_URL=
LLM_API_KEY=

# Exec - live mode only (trade-only, withdrawals DISABLED, IP-locked)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Watchdog - separate process, cancel/close-only credentials
WATCHDOG_API_KEY=
WATCHDOG_API_SECRET=

# Control plane
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
